# All optional. Set these in your shell or your host's dashboard; the app
# reads real environment variables and does not load this file itself.
# DATABASE_URL defaults to a SQLite file at backend/data/app.db
# DATABASE_URL=sqlite:////absolute/path/to/app.db
CORS_ORIGINS=http://localhost:3000
SEED_ON_STARTUP=true
RATE_LIMIT_CAPACITY=120
RATE_LIMIT_REFILL_PER_SECOND=2
